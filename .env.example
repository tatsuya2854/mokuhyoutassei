# ここに書いていいのは「自分のサーバーのURL」だけ。
# API キー・シークレットは絶対に置かない（Vite は VITE_ で始まる値を
# そのままバンドルに埋め込むので、置いた時点で全員に公開される）。
#
# 未設定なら、どちらも端末内で完結する実装に自動で落ちる。

# 決済（Stripe）。サーバーが secret key を持ち、Checkout の URL を返す。
#   GET  /subscription            -> Subscription | null
#   POST /checkout {planId,cycle} -> { url }
#   POST /portal                  -> { url }
# VITE_BILLING_API=https://api.example.com/billing

# AI秘書を外部LLMに差し替える場合。サーバーが鍵を持つ。
#   POST /assistant {text,ctx} -> { text, actions? }
# VITE_ASSISTANT_API=https://api.example.com

# GitHub Pages などサブディレクトリ配信のときだけ使う（CI が自動で渡す）。
# VITE_BASE=/mokuhyoutassei/
